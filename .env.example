POSTGRES_USER=endividamento
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=endividamento
POSTGRES_PORT=5434

# development = local/compose.dev | production = docker-compose.prod.yml (fail-fast de secrets)
NODE_ENV=development

API_PORT=3001
WEB_PORT=5173
JWT_SECRET=change-this-to-a-long-random-secret-32chars
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=support@clarityib.com.br
ADMIN_PASSWORD=Endividamento!Local1
# ADMIN_EMAIL/ADMIN_PASSWORD definem o usuário master da plataforma (PLATFORM_MASTER; vê control plane; data plane só com sessão de suporte).
# Documentação: docs/platform/PLATFORM-MASTER.md
# Em produção use .env.production.example — a senha local acima é rejeitada se NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Criptografia das credenciais de integração ERP (AES-256-GCM).
# Se vazio, a API usa JWT_SECRET.
# Em produção é obrigatória e distinta do JWT (≥32 chars).
CREDENTIALS_ENCRYPTION_KEY=

# Uso local da API fora do Docker:
# DATABASE_URL=postgres://endividamento:change-this-password@127.0.0.1:5434/endividamento

# URL pública do front (cadastro, convite, senha e links de notificação)
APP_PUBLIC_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# emails-api (serviço central de e-mail da Clarity) — hoje só o convite de usuário.
# Sem essas duas variáveis a API sobe normal e o convite não é enviado: o link
# aparece na tela para o administrador copiar (fora de produção).
EMAIL_SERVICE_URL=
EMAIL_SERVICE_API_KEY=

# SMTP para cadastro e redefinição de senha. Sem SMTP o link é exibido na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Endividamento <noreply@localhost>

# Envio de e-mail (avisos de status de contrato, PDFs): ainda não configurado.
# Sem essas variáveis, o envio fica registrado em NotificationLog como "simulado".
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_EMAIL=
