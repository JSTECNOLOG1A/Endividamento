POSTGRES_USER=endividamento
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=endividamento
POSTGRES_PORT=5434

API_PORT=3001
WEB_PORT=5173
JWT_SECRET=change-this-to-a-long-random-secret-32chars
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@endividamento.local
ADMIN_PASSWORD=Endividamento!Local1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Criptografia das credenciais de integração ERP (AES-256-GCM).
# Se vazio, a API usa JWT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# Uso local da API fora do Docker:
# DATABASE_URL=postgres://endividamento:change-this-password@127.0.0.1:5434/endividamento

# Base pública do front-end — usada só pra montar links dentro dos e-mails
# de notificação (ex.: "acesse o link para revisar").
APP_BASE_URL=http://localhost:5173

# Envio de e-mail (avisos de status de contrato, PDFs por e-mail): ainda não
# configurado. Enquanto essas variáveis não existirem, tudo fica registrado
# em NotificationLog com status "simulado", sem nenhum envio real.
# Caminho recomendado (Microsoft 365, sem depender de Basic Auth/SMTP, que a
# Microsoft está desativando por padrão a partir de dez/2026): registrar um
# app no Entra ID com permissão de aplicativo "Mail.Send" e preencher:
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_EMAIL=
