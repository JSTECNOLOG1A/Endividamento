POSTGRES_USER=endividamento
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=endividamento
POSTGRES_PORT=5434

API_PORT=3001
WEB_PORT=5173
JWT_SECRET=change-this-to-a-long-random-secret-32chars
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@endividamento.local
ADMIN_PASSWORD=Endividamento!Local1
# ADMIN_EMAIL/ADMIN_PASSWORD definem o usuário master da plataforma (vê todos os clientes; acesso registrado).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Criptografia das credenciais de integração ERP (AES-256-GCM).
# Se vazio, a API usa JWT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# Uso local da API fora do Docker:
# DATABASE_URL=postgres://endividamento:change-this-password@127.0.0.1:5434/endividamento

# URL pública do front (link do e-mail de cadastro)
APP_PUBLIC_URL=http://localhost:5173

# SMTP para cadastro, convite e redefinição de senha. Sem SMTP o link é exibido na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Endividamento <noreply@localhost>
