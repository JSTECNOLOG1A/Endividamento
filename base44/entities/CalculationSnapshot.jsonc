{
  "name": "CalculationSnapshot",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "ID do contrato relacionado"
    },
    "contract_number": {
      "type": "string",
      "description": "N\u00famero do contrato (refer\u00eancia leg\u00edvel)"
    },
    "engine_version": {
      "type": "string",
      "description": "Vers\u00e3o do engine que realizou o c\u00e1lculo (ex: 1.2.1)"
    },
    "engine_build_id": {
      "type": "string",
      "description": "Build ID do engine (ex: build-20260221-post-merge)"
    },
    "calculation_hash_strict": {
      "type": "string",
      "description": "Hash SHA-256 determin\u00edstico dos inputs (reprodutibilidade garantida)"
    },
    "calculation_hash_instance": {
      "type": "string",
      "description": "Hash SHA-256 com timestamp (identificador \u00fanico do evento de c\u00e1lculo)"
    },
    "schedule_snapshot": {
      "type": "string",
      "description": "JSON serializado completo da tabela de amortiza\u00e7\u00e3o"
    },
    "disclosure_snapshot": {
      "type": "string",
      "description": "JSON serializado com disclosure regulat\u00f3rio (BACEN)"
    },
    "risk_flags_snapshot": {
      "type": "string",
      "description": "JSON serializado com flags de risco (anatocismo, PTAX_GAP, etc)"
    },
    "audit_log_snapshot": {
      "type": "string",
      "description": "JSON serializado com audit log da opera\u00e7\u00e3o"
    },
    "currency": {
      "type": "string",
      "enum": [
        "BRL",
        "USD",
        "EUR"
      ],
      "description": "Moeda do contrato"
    },
    "principal": {
      "type": "number",
      "description": "Valor do principal (em moeda base)"
    },
    "total_interest": {
      "type": "number",
      "description": "Total de juros calculados"
    },
    "total_paid": {
      "type": "number",
      "description": "Total a ser pago (principal + juros)"
    },
    "trigger_event": {
      "type": "string",
      "enum": [
        "APPROVED",
        "RECALCULATED",
        "REOPENED",
        "IMPORTED"
      ],
      "description": "Evento que disparou a cria\u00e7\u00e3o do snapshot"
    },
    "calculation_parameters": {
      "type": "string",
      "description": "JSON serializado com par\u00e2metros de entrada (para auditoria)"
    },
    "metadata": {
      "type": "string",
      "description": "JSON serializado com metadados adicionais (taxa PTAX, indexador snapshot, etc)"
    },
    "immutable_flag": {
      "type": "boolean",
      "default": true,
      "description": "Flag de imutabilidade (sempre true ap\u00f3s cria\u00e7\u00e3o)"
    }
  },
  "required": [
    "contract_id",
    "contract_number",
    "engine_version",
    "engine_build_id",
    "calculation_hash_strict",
    "calculation_hash_instance",
    "schedule_snapshot",
    "currency",
    "principal",
    "total_interest",
    "total_paid",
    "trigger_event"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}