# Copie para .env.production e preencha com valores FORTES antes do primeiro boot.
# Nunca commite .env.production.

NODE_ENV=production

POSTGRES_USER=endividamento
POSTGRES_PASSWORD=SUBSTITUA_senha_postgres_longa
POSTGRES_DB=endividamento

# Porta pública do nginx (HTTP). Coloque TLS na frente (Caddy/Traefik/Cloudflare).
WEB_PORT=8080

# Secrets — validateSecrets.js rejeita placeholders e a senha local Endividamento!Local1
JWT_SECRET=SUBSTITUA_jwt_com_pelo_menos_32_caracteres_aleatorios
JWT_EXPIRES_IN=8h
CREDENTIALS_ENCRYPTION_KEY=SUBSTITUA_chave_aes_com_pelo_menos_32_caracteres

ADMIN_EMAIL=seu-master@suaempresa.com
ADMIN_PASSWORD=SUBSTITUA_senha_master_forte_12plus

# Origem pública HTTPS do front (mesma URL que o usuário abre no browser)
APP_PUBLIC_URL=https://app.suaempresa.com
APP_BASE_URL=https://app.suaempresa.com
CORS_ORIGINS=https://app.suaempresa.com

# emails-api (serviço central de e-mail da Clarity) — envio do convite de usuário.
# No VPS Clarity o host resolve pela rede `pagamentos-net` (ver docker-compose.traefik.yml).
# Se ficar vazio, a API sobe normal e o convite não sai.
EMAIL_SERVICE_URL=http://emails-api:3003
EMAIL_SERVICE_API_KEY=

# SMTP (recomendado em produção — reset de senha e cadastro de empresa)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AllDebt <noreply@suaempresa.com>

LOG_LEVEL=info
